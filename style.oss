date-picker {
  header {
    text {
      font-size: 17.0,
    }

    stack {
      justify: space-between,
      gap: 0.0,
    }

    button {
      padding: [6.0, 0.0],
      border-radius: 2.0,
      color: $container.background,
    }

    container {
      background: $theme.surface-high,
      border-width: 0.0,
      padding: 2.0,
    }
  }

  day-name.text {
    font-weight: bold,
    color: $theme.accent,
  }

  stack {
    align: stretch,
    gap: 5.0,
  }

  text {
    font-size: 14.0,
  }

  day-other-month.text {
    color: $theme.contrast-low,
  }

  day-selected.button {
    border-width: [0.0, 0.0, 2.0, 0.0],
    border-radius: 0.0,
    border-color: $theme.primary,
  }

  button {
    padding: 0.0,
    color: $theme.surface,
  }

  container {
    padding: 6.0,
    border-width: 1.0,
    border-radius: 6.0,
  }
}
